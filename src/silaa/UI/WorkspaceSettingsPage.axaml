<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:silaa.UI"
             xmlns:vm="using:silaa.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="silaa.UI.WorkspaceSettingsPage"
             x:DataType="vm:WorkspaceSettingsViewModel"
             Background="{DynamicResource SiBackgroundBrush}">
  <UserControl.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource SiMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LineHeight" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource SiMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.form-card">
      <Setter Property="Background" Value="{DynamicResource SiPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SiDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource SiAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SiOnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="15,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SiForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SiDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="11,7" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*">
    <Border IsVisible="{Binding HasNavigation}">
      <ui:SettingsMenuView DataContext="{Binding Navigation}" />
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Background="{DynamicResource SiGlassBrush}"
              BorderBrush="{DynamicResource SiGlassBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="22,12" ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <StackPanel Spacing="2">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding PageTitle}" />
            <TextBlock FontSize="10.5" Foreground="{DynamicResource SiMutedBrush}"
                       Text="{Binding PageSubtitle}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center"
                  Command="{Binding BackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <materialIcons:MaterialIcon Classes="ui-icon foreground" Kind="ArrowLeft" />
              <TextBlock VerticalAlignment="Center" Text="돌아가기" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{DynamicResource SiContentMaxWidth}"
                    Margin="{DynamicResource SiCompactPageMargin}" Spacing="18"
                    HorizontalAlignment="Stretch">
          <StackPanel Spacing="5" IsVisible="{Binding IsFolderSettings}">
            <TextBlock Classes="eyebrow" Text="FOLDER ACCESS" />
            <TextBlock FontSize="21" FontWeight="SemiBold" Text="접근 허용 폴더" />
            <TextBlock Classes="help" Text="Agent가 제안한 폴더 요청에서 ‘전체 허용’을 선택해도 이 목록에 자동으로 추가됩니다." />
          </StackPanel>

          <Border Classes="form-card" IsVisible="{Binding IsFolderSettings}">
            <StackPanel Spacing="14">
              <TextBlock Classes="label" Text="기본 작업 폴더" />
              <TextBlock Classes="help" Text="일반 대화, 프로젝트 탐색과 로컬 도구의 기본 기준 폴더입니다. LLM 연결에는 영향을 주지 않습니다." />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Workspace, Mode=TwoWay}" PlaceholderText="기본 작업 폴더" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding BrowseWorkspaceCommand}" Content="찾기" />
              </Grid>

              <Border Height="1" Background="{DynamicResource SiDividerBrush}" Margin="0,2" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                  <TextBlock Classes="label" Text="전체 허용 폴더" />
                  <TextBlock Classes="help" Text="{Binding FolderSummary}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center"
                        Command="{Binding AddDirectoryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <materialIcons:MaterialIcon Classes="ui-icon foreground" Width="14" Height="14" Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="폴더 추가" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding AllowedDirectories}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AllowedDirectoryItemViewModel">
                    <Border Padding="10,8" CornerRadius="7" Background="{DynamicResource SiRaisedBrush}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock FontSize="10.5" FontFamily="Cascadia Mono, Consolas, monospace"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Path}" />
                        <Button Grid.Column="1" Classes="secondary" Padding="9,5"
                                Command="{Binding RemoveCommand}" Content="제거" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Spacing="5" Margin="1,6,1,0" IsVisible="{Binding IsSecuritySettings}">
            <TextBlock Classes="eyebrow" Text="AGENT SECURITY" />
            <TextBlock FontSize="21" FontWeight="SemiBold" Text="Agent 보안" />
            <TextBlock Classes="help" Text="네트워크는 기본 거부됩니다. Agent 요청 카드에서 ‘전체 허용’을 선택한 주소도 여기에 자동으로 추가됩니다." />
          </StackPanel>

          <Border Classes="form-card" IsVisible="{Binding IsSecuritySettings}">
            <StackPanel Spacing="13">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="#3DD68C" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="label" Text="OpenShell-inspired enforce" />
                  <TextBlock Classes="help" Text="{Binding SecuritySummary}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding NewNetworkEndpoint, Mode=TwoWay}"
                         PlaceholderText="예: api.github.com:443 또는 https://api.github.com" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding AddNetworkEndpointCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <materialIcons:MaterialIcon Classes="ui-icon foreground" Width="14" Height="14" Kind="Plus" />
                    <TextBlock VerticalAlignment="Center" Text="주소 추가" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding AllowedNetworkEndpoints}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NetworkEndpointItemViewModel">
                    <Border Padding="10,8" CornerRadius="7" Background="{DynamicResource SiRaisedBrush}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock FontSize="10.5" FontFamily="Cascadia Mono, Consolas, monospace"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Endpoint}" />
                        <Button Grid.Column="1" Classes="secondary" Padding="9,5"
                                Command="{Binding RemoveCommand}" Content="제거" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="16,11" Background="{DynamicResource SiGlassBrush}"
              BorderBrush="{DynamicResource SiGlassBorderBrush}" BorderThickness="0,1,0,0">
        <Grid MaxWidth="{DynamicResource SiContentMaxWidth}" HorizontalAlignment="Stretch"
              ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SiMutedBrush}"
                     FontSize="10.75" TextWrapping="Wrap" Text="{Binding Status}" />
          <Button Grid.Column="1" Classes="primary" MinWidth="116"
                  Command="{Binding SaveCommand}" Content="설정 저장" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

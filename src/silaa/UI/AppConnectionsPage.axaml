<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:silaa.ViewModels"
             xmlns:ui="using:silaa.UI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="silaa.UI.AppConnectionsPage"
             x:DataType="vm:AppConnectionsViewModel">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ui:MainMenuView DataContext="{Binding Navigation}" />
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="900" Margin="40,34,40,60" HorizontalAlignment="Stretch" Spacing="22">
        <StackPanel Spacing="5">
          <TextBlock FontSize="23" FontWeight="SemiBold" Text="앱 연결" />
          <TextBlock FontSize="11.5" Foreground="{DynamicResource SiMutedBrush}"
                     Text="GitHub, OneDrive 같은 외부 서비스를 Agent가 안전하게 사용할 수 있도록 연결합니다." />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Padding="18" CornerRadius="12" Background="{DynamicResource SiPanelBrush}"
                  BorderBrush="{DynamicResource SiDividerBrush}" BorderThickness="1">
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SiRaisedBrush}">
                  <materialIcons:MaterialIcon Classes="ui-icon foreground" HorizontalAlignment="Center" Kind="Github" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="GitHub" />
                  <TextBlock FontSize="10" Foreground="{DynamicResource SiMutedBrush}" Text="저장소·파일 읽기" />
                </StackPanel>
              </Grid>
              <TextBox Text="{Binding GitHubName}" PlaceholderText="연결 이름" />
              <TextBox Text="{Binding GitHubAccount}" PlaceholderText="계정 이름(선택)" />
              <TextBox Text="{Binding GitHubToken}" PasswordChar="●" PlaceholderText="Personal access token" />
              <TextBlock FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource SiMutedBrush}"
                         Text="토큰은 settings.json이 아니라 Windows DPAPI Vault에 저장됩니다." />
              <Button Classes="primary" HorizontalAlignment="Right" Command="{Binding ConnectGitHubCommand}" Content="GitHub 연결" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Padding="18" CornerRadius="12" Background="{DynamicResource SiPanelBrush}"
                  BorderBrush="{DynamicResource SiDividerBrush}" BorderThickness="1">
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SiRaisedBrush}">
                  <materialIcons:MaterialIcon Classes="ui-icon foreground" HorizontalAlignment="Center" Kind="MicrosoftOnedrive" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="OneDrive" />
                  <TextBlock FontSize="10" Foreground="{DynamicResource SiMutedBrush}" Text="Windows 동기화 폴더 읽기" />
                </StackPanel>
              </Grid>
              <TextBox Text="{Binding OneDriveName}" PlaceholderText="연결 이름" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                <TextBox Text="{Binding OneDrivePath}" PlaceholderText="OneDrive 동기화 폴더" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding ChooseOneDriveFolderCommand}" Content="찾기" />
              </Grid>
              <TextBlock FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource SiMutedBrush}"
                         Text="클라우드 동기화는 OneDrive 앱이 담당하고 silaa는 선택한 로컬 폴더만 읽습니다." />
              <Button Classes="primary" HorizontalAlignment="Right" Command="{Binding ConnectOneDriveCommand}" Content="OneDrive 연결" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontSize="14" FontWeight="SemiBold" Text="연결된 앱" />
          <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource SiMutedBrush}" Text="{Binding Status}" />
        </Grid>
        <Border IsVisible="{Binding IsEmpty}" Padding="18" CornerRadius="10"
                Background="{DynamicResource SiPanelBrush}" BorderBrush="{DynamicResource SiDividerBrush}" BorderThickness="1">
          <TextBlock Foreground="{DynamicResource SiMutedBrush}" Text="아직 연결된 앱이 없습니다." />
        </Border>
        <ItemsControl ItemsSource="{Binding Connections}" IsVisible="{Binding HasConnections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AppConnectionItemViewModel">
              <Border Margin="0,0,0,8" Padding="14" CornerRadius="10"
                      Background="{DynamicResource SiPanelBrush}" BorderBrush="{DynamicResource SiDividerBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SiRaisedBrush}">
                    <materialIcons:MaterialIcon Classes="ui-icon foreground" HorizontalAlignment="Center" Kind="LinkVariant" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource SiMutedBrush}" Text="{Binding Provider}" />
                    <TextBlock FontSize="9.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SiMutedBrush}" Text="{Binding Detail}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="5">
                    <TextBlock FontSize="9.5" Foreground="{DynamicResource SiMutedBrush}" Text="{Binding Access}" />
                    <Button Classes="secondary" HorizontalAlignment="Right" Command="{Binding RemoveCommand}" Content="연결 해제" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Padding="14" CornerRadius="10" Background="{DynamicResource SiRaisedBrush}">
          <TextBlock FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource SiMutedBrush}"
                     Text="Google Drive, Notion, Slack, Microsoft 365는 같은 어댑터 구조로 확장됩니다. 현재는 GitHub 읽기 API와 OneDrive 동기화 폴더를 우선 지원합니다." />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
